        </activity-alias>

        <activity-alias
            android:name=".app.icon.NcAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nc"
            android:roundIcon="@mipmap/ic_launcher_nc_round"
