            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".app.icon.DoosanAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_doosan"
            android:roundIcon="@mipmap/ic_launcher_doosan_round"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
