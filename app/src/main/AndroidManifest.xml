                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".app.icon.LgAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lg"
            android:roundIcon="@mipmap/ic_launcher_lg_round"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".app.icon.LotteAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lotte"
            android:roundIcon="@mipmap/ic_launcher_lotte_round"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
